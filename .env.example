# Keka Portal Settings
KEKA_URL=https://yourcompany.keka.com

# Telegram Bot Credentials
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get your personal Chat ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Schedule & Shift Settings
# Morning reminder time (24-hour format HH:MM, Mon-Fri)
MORNING_REMINDER_TIME=09:30

# Shift length to wait before evening reminder (in minutes: 9 hours + 5 minutes buffer = 545)
SHIFT_DURATION_MINUTES=545

# Timezone (e.g., Asia/Kolkata, Asia/Dubai, Europe/London, America/New_York)
TIMEZONE=Asia/Kolkata

# Geolocation Coordinates (Keka often prompts for location during clock-in)
# Defaults to India Tech Hub coords (e.g. Hyderabad / Bangalore); customize to your office/home
GEO_LATITUDE=17.4483
GEO_LONGITUDE=78.3915

# Browser Execution Mode (True = invisible background window, False = visible Chrome window)
HEADLESS=True
